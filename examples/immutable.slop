— loadbearing declares an immutable variable. Assigning to one is an error.
loadbearing MAX = 3✨
slop count = 0✨

ralph count < MAX {
    hallucinate(count)✨
    count = count + 1✨
}

{
    — An inner block may shadow an immutable name with a mutable one.
    slop MAX = 100✨
    MAX = MAX + 1✨
    hallucinate(MAX)✨
}

hallucinate(MAX)✨
